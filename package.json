{
  "name": "myenglish-bo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev-ssl": "HTTPS=true NODE_EXTRA_CA_CERTS=$(mkcert -CAROOT)/rootCA.pem next dev --turbopack -p 3400 & local-ssl-proxy --key backoffice.myenglish.com-key.pem --cert backoffice.myenglish.com.pem --source 443 --target 3400",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "start": "next start",
    "start-ssl": "HTTPS=true NODE_EXTRA_CA_CERTS=$(mkcert -CAROOT)/rootCA.pem next start -p 3400 & local-ssl-proxy --key backoffice.myenglish.com-key.pem --cert backoffice.myenglish.com.pem --source 443 --target 3400",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "axios": "^1.20.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.5",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
